                "args": [
                    "set -uo pipefail\necho \"=== start $(date -u) node=${NODE_NAME:-?}\"\nA=/mnt/aside\nCACHE=/mnt/proxy/feats/siglip2/libero_spatial\nEXP=\"ep000272.npy ep000272.stats.npy ep000274.npy ep000274.stats.npy ep000276.npy ep000276.stats.npy ep000278.npy ep000278.stats.npy ep000280.npy ep000280.stats.npy ep000282.npy ep000282.stats.npy ep000284.npy ep000284.stats.npy ep000286.npy ep000286.stats.npy\"\n# --- mounts: /mnt/proxy read-only, /mnt/aside a separate read-write mount\ngrep -E ' (/mnt/proxy|/mnt/aside) ' /proc/mounts\nPO=$(awk '$2==\"/mnt/proxy\"{o=$4} END{print o}' /proc/mounts)\nAO=$(awk '$2==\"/mnt/aside\"{o=$4} END{print o}' /proc/mounts)\ncase \",$PO,\" in *,ro,*) ;; *) echo \"ABORT (20): /mnt/proxy is not mounted read-only (options: '$PO')\"; exit 20 ;; esac\ncase \",$AO,\" in *,rw,*) ;; *) echo \"ABORT (20): /mnt/aside is not a read-write mount (options: '$AO')\"; exit 20 ;; esac\n[ -d \"$CACHE\" ] || { echo \"ABORT (20): $CACHE is missing\"; exit 20; }\nRO=/mnt/proxy/logs/siglip2-repair-e5377cd5-8d1c-47a8-84c5-d2ce617540df/libero_spatial\n[ -d \"$RO\" ] \u0026\u0026 [ \"$(stat -c %i \"$A\")\" = \"$(stat -c %i \"$RO\")\" ] || { echo \"ABORT (20): $A is not the folder $RO (inodes $(stat -c %i \"$A\" 2\u003e\u00261) / $(stat -c %i \"$RO\" 2\u003e\u00261))\"; exit 20; }\n\n# --- READ\necho \"=== READ $(date -u)\"\nshow() {\n  local f=$1 b; b=$(stat -c %s \"$f\")\n  if [ \"$b\" -gt 8388608 ]; then echo \"@@@ SKIPPED $f bytes $b (over 8 MB)\"; return; fi\n  echo \"@@@ BEGIN $f sha256 $(sha256sum \u003c \"$f\" | cut -d' ' -f1) bytes $b lines $(wc -l \u003c \"$f\")\"\n  cat \"$f\"; echo\n  echo \"@@@ END $f\"\n}\nREAD_RC=30\nls -la --time-style=full-iso /mnt/proxy/logs/ | grep -F pairings-smoke || echo \"no pairings-smoke file in /mnt/proxy/logs\"\nls -laR --time-style=full-iso /mnt/proxy/rollouts/pairings-smoke/none-s0/ || echo \"no rollouts folder for the none smoke\"\nfor f in /mnt/proxy/logs/pairings-smoke-none-s0-*; do\n  [ -f \"$f\" ] || continue\n  case \"$f\" in *.log) READ_RC=0 ;; esac\n  show \"$f\"\ndone\nwhile IFS= read -r f; do show \"$f\"; done \u003c \u003c(find /mnt/proxy/rollouts/pairings-smoke/none-s0 -type f 2\u003e/dev/null | sort)\n[ \"$READ_RC\" = 0 ] || echo \"READ PROBLEM (30): no /mnt/proxy/logs/pairings-smoke-none-s0-*.log\"\n\n# --- DELETE\necho \"=== DELETE $(date -u): $A = logs/siglip2-repair-e5377cd5-8d1c-47a8-84c5-d2ce617540df/libero_spatial\"\ndf -h /mnt/proxy | tail -1\nls -la --time-style=full-iso \"$A\"\nLIST=$(find \"$A\" -xdev -mindepth 1 -printf '%y %P\\n' | sort -k2)\nn=0; bad=0\nwhile read -r t p; do\n  [ -n \"$t\" ] || continue\n  n=$((n+1))\n  case \" $EXP \" in\n    *\" $p \"*) [ \"$t\" = f ] || { echo \"UNEXPECTED type $t: $p\"; bad=1; } ;;\n    *) echo \"UNEXPECTED entry: $t $p\"; bad=1 ;;\n  esac\ndone \u003c\u003c\u003c \"$LIST\"\necho \"entries in the aside folder: $n (16 on a first run)\"\nfor p in $EXP; do\n  [ -s \"$CACHE/$p\" ] || { echo \"MISSING or empty replacement in the cache: $CACHE/$p\"; bad=1; }\ndone\nif [ \"$bad\" != 0 ]; then echo \"ABORT (23): nothing deleted\"; exit 23; fi\nfor p in $EXP; do\n  [ -f \"$A/$p\" ] || continue\n  echo \"to delete: $p bytes $(stat -c %s \"$A/$p\") sha256 $(sha256sum \u003c \"$A/$p\" | cut -d' ' -f1); replacement bytes $(stat -c %s \"$CACHE/$p\")\"\ndone\nfor p in $EXP; do find \"$A\" -xdev -mindepth 1 -maxdepth 1 -type f -name \"$p\" -delete; done\nleft=$(find \"$A\" -mindepth 1 | wc -l) || { echo \"ABORT (24): could not list $A after the delete\"; exit 24; }\necho \"--- after $(date -u)\"; ls -la --time-style=full-iso \"$A\"; df -h /mnt/proxy | tail -1\n[ \"$left\" = 0 ] || { echo \"ABORT (24): $left entries left in $A\"; exit 24; }\necho \"=== deleted: $n file(s); $A is empty\"\necho \"=== exit $READ_RC $(date -u)\"\nexit $READ_RC\n"
